# Copy to the same folder as the executable (packaged zip) or to mac-agent/.env / repo root .env (dev)

# Project API key from ProjectMind → Project → Settings → API keys
IMEMORY_API_KEY=imk_your_project_api_key

# Local app MCP endpoint (default). For production, use your deployed URL (no trailing slash).
IMEMORY_MCP_URL=http://localhost:8080/api/mcp

# How often to heartbeat while running (milliseconds, min 5000). Default 60000.
# IMEMORY_HEARTBEAT_INTERVAL_MS=60000

# How often to poll for jobs (milliseconds, min 1000). Default 5000.
# IMEMORY_JOB_POLL_INTERVAL_MS=5000

# Required to execute jobs — comma-separated absolute roots the agent may use as cwd.
# Example: IMEMORY_WORKSPACE_ALLOWLIST=/Users/you/CursorIDE,/Users/you/work
IMEMORY_WORKSPACE_ALLOWLIST=

# Optional opaque agent identity (recommended on shared/SaaS). Default is guessable host:<ComputerName>.
# IMEMORY_AGENT_KEY=agt_use_a_long_random_string

# Optional — required for global keys (imgk_) or multi-project OAuth users
# IMEMORY_PROJECT_SLUG=your-project-slug

# --- Runners ---
# Default job runner is `auto`: CURSOR_API_KEY → Cursor SDK, else Cursor CLI, else Codex CLI,
# else Antigravity, else Claude CLI, else Copilot CLI.
# You can override this default behavior globally in the agent with IMEMORY_DEFAULT_RUNNER (or IMEMORY_DEFAULT_AI).
# Supported variants:
# - auto            (cascade: cursor_sdk -> cursor_cli -> codex_cli -> antigravity_cli -> claude_cli -> copilot_cli)
# - cursor_sdk      (Cursor SDK local runner via API key)
# - cursor_cli      (Cursor Agent CLI)
# - codex_cli       (OpenAI Codex CLI)
# - antigravity_cli (Google Antigravity CLI)
# - claude_cli      (Anthropic Claude Code CLI)
# - copilot_cli     (GitHub Copilot CLI)
# - openrouter      (OpenRouter API with cwd-scoped tools; explicit selection only)
# - tokenrouter     (TokenRouter API with cwd-scoped tools; explicit selection only)
# - llm_api         (Raw LLM API with tools)
# IMEMORY_DEFAULT_RUNNER=auto
# IMEMORY_DEFAULT_AI=auto

# Cursor SDK local runner (used first by auto when key is set)
CURSOR_API_KEY=
# IMEMORY_CURSOR_MODEL=composer-2.5

# Cursor Agent CLI runner (`agent` / `cursor-agent` on PATH)
# Uses CURSOR_API_KEY when set; otherwise relies on `agent login` session.
# IMEMORY_CURSOR_CLI_BIN=agent
# IMEMORY_CURSOR_MODEL=composer-2.5

# OpenAI Codex CLI runner (`codex` on PATH)
# Prefers CODEX_API_KEY; falls back to OPENAI_API_KEY / IMEMORY_LLM_API_KEY.
# Or use `codex login` for ChatGPT-managed auth.
# CODEX_API_KEY=
# IMEMORY_CODEX_CLI_BIN=codex
# IMEMORY_CODEX_MODEL=
# IMEMORY_CODEX_SANDBOX=workspace-write

# Google Antigravity CLI runner (`agy` on PATH)
# Sign in once with `agy` interactively, then unattended jobs use -p + skip-permissions.
# IMEMORY_ANTIGRAVITY_CLI_BIN=agy
# IMEMORY_ANTIGRAVITY_MODEL=Gemini 3.5 Flash (High)
# IMEMORY_ANTIGRAVITY_SKIP_PERMISSIONS=1

# Anthropic Claude Code CLI runner (`claude` on PATH)
# Prefers ANTHROPIC_API_KEY / IMEMORY_CLAUDE_API_KEY; otherwise uses `claude` login session.
# Unattended jobs use -p --output-format stream-json --dangerously-skip-permissions.
# ANTHROPIC_API_KEY=
# IMEMORY_CLAUDE_CLI_BIN=claude
# IMEMORY_CLAUDE_MODEL=
# IMEMORY_CLAUDE_SKIP_PERMISSIONS=1
# Optional alternative to skip-permissions: IMEMORY_CLAUDE_PERMISSION_MODE=acceptEdits

# GitHub Copilot CLI runner (`copilot` on PATH)
# Prefers COPILOT_GITHUB_TOKEN / GH_TOKEN / GITHUB_TOKEN; otherwise uses `copilot` login.
# Unattended jobs use -p --no-ask-user --allow-all.
# COPILOT_GITHUB_TOKEN=
# IMEMORY_COPILOT_CLI_BIN=copilot
# IMEMORY_COPILOT_MODEL=
# IMEMORY_COPILOT_ALLOW_ALL=1

# LLM API runner (cwd-scoped tools)
OPENAI_API_KEY=
# or: IMEMORY_LLM_API_KEY=
# IMEMORY_LLM_MODEL=gpt-4.1-mini
# IMEMORY_LLM_BASE_URL=https://api.openai.com/v1

# OpenRouter agent runner (explicit selection; not part of the auto cascade)
# OPENROUTER_API_KEY=
# IMEMORY_OPENROUTER_MODEL=openai/gpt-4.1-mini
# IMEMORY_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Optional attribution headers shown by OpenRouter:
# IMEMORY_OPENROUTER_HTTP_REFERER=https://projectm.dev
# IMEMORY_OPENROUTER_APP_TITLE=ProjectMind Agent

# TokenRouter agent runner (explicit selection; not part of the auto cascade)
# TOKENROUTER_API_KEY=
# IMEMORY_TOKENROUTER_MODEL=openai/gpt-4.1-mini
# IMEMORY_TOKENROUTER_BASE_URL=https://api.tokenrouter.com/v1

# Persist runner/model usage counts (default: ~/.imemory/desktop-agent-llm-usage.json)
# IMEMORY_LLM_STATS_PATH=

# --- Provider pacing (responsible automated usage) ---
# Minimum gap between any provider invoke (ms). Default 15000.
# IMEMORY_PROVIDER_MIN_GAP_MS=15000
# Extra random jitter added to the min gap (0..N ms). Default 5000.
# IMEMORY_PROVIDER_GAP_JITTER_MS=5000
# Cooldown after 429 / resource_exhausted when Retry-After is absent (ms). Default 300000.
# IMEMORY_PROVIDER_COOLDOWN_MS=300000
# Soft per-provider job RPM caps (sliding 60s window). Defaults: Cursor 4, Codex/Antigravity/Claude/Copilot 6, OpenRouter/TokenRouter/LLM 10.
# IMEMORY_CURSOR_MAX_RPM=4
# IMEMORY_CODEX_MAX_RPM=6
# IMEMORY_ANTIGRAVITY_MAX_RPM=6
# IMEMORY_CLAUDE_MAX_RPM=6
# IMEMORY_COPILOT_MAX_RPM=6
# IMEMORY_OPENROUTER_MAX_RPM=10
# IMEMORY_TOKENROUTER_MAX_RPM=10
# IMEMORY_LLM_API_MAX_RPM=10
# Prefer authenticated runners in auto cascade (skip cursor_cli when CURSOR_API_KEY is set). Default 1.
# IMEMORY_PREFER_AUTHENTICATED=1

# --- After a successful job ---
# Commit dirty tree with a short message from the runner summary, then push.
# Set to 0 to disable. Requires git credentials that can push without a prompt.
# IMEMORY_AGENT_GIT_COMMIT=1
# IMEMORY_AGENT_GIT_PUSH=1

# --- Visual snapshots (Assets/UI/<Page>/) ---
# After a successful implement job that touched UI/frontend files, capture
# full-page Playwright screenshots and upload them via saveVisualSnapshot.
# Unset = auto (UI changes only). 1 = always. 0 = never.
# IMEMORY_VISUAL_SNAPSHOT=1
# IMEMORY_VISUAL_BASE_URL=http://localhost:8080
# IMEMORY_VISUAL_ROUTES=/,/login,/dashboard
# IMEMORY_VISUAL_VIEWPORT=1280x720
# IMEMORY_VISUAL_ENVIRONMENT=local
# Requires Playwright in the managed project: npm i -D playwright && npx playwright install chromium
