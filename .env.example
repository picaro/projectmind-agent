# ProjectMind Agent - Essential Configuration
# 
# This file contains only the essential settings to get started.
# For advanced options, see .env.advanced.example

# ============================================================================
# REQUIRED CONFIGURATION
# ============================================================================

# Project API key from ProjectMind → Project → Settings → API keys
IMEMORY_API_KEY=

# ProjectMind MCP endpoint (use production URL unless running locally)
IMEMORY_MCP_URL=https://projectm.dev/api/mcp
# For local development: IMEMORY_MCP_URL=http://localhost:8080/api/mcp

# Workspace allowlist - comma-separated absolute paths where agent can work
# Example: /Users/yourname/projects or C:/Users/YourName/Projects
IMEMORY_WORKSPACE_ALLOWLIST=

# ============================================================================
# RECOMMENDED: AI ASSISTANT CONFIGURATION
# ============================================================================
# Set at least ONE of these to enable job execution

# Cursor SDK API key (recommended - easiest setup)
# Get from Cursor settings
CURSOR_API_KEY=

# Alternatively, install one of these CLIs and ensure it's on your PATH:
# - Cursor Agent CLI: https://cursor.com (binary: agent or cursor-agent)
# - Codex CLI: npm i -g @openai/codex (binary: codex)
# - Claude CLI: https://code.claude.com (binary: claude)
# - Copilot CLI: https://docs.github.com/copilot (binary: copilot)
# - Antigravity CLI: https://antigravity.google (binary: agy)

# Or use direct API keys:
# CODEX_API_KEY=          # For Codex CLI
# ANTHROPIC_API_KEY=      # For Claude CLI  
# OPENAI_API_KEY=         # For direct OpenAI API access
# COPILOT_GITHUB_TOKEN=   # For Copilot CLI

# ============================================================================
# OPTIONAL CONFIGURATION
# ============================================================================

# Agent identity (recommended for shared/production deployments)
# Default is host:<ComputerName> which may be predictable
# IMEMORY_AGENT_KEY=agt_your_unique_identifier

# Project slug (required for global API keys or multi-project users)
# IMEMORY_PROJECT_SLUG=your-project-slug

# Runner selection (default: auto - cascades through available runners)
# Options: auto | cursor_sdk | cursor_cli | codex_cli | claude_cli | copilot_cli
# IMEMORY_DEFAULT_RUNNER=auto

# Auto-update (enabled by default)
# Set to 0 to disable automatic updates
# IMEMORY_AGENT_AUTO_UPDATE=1

# ============================================================================
# NEED MORE OPTIONS?
# ============================================================================
# See .env.advanced.example for:
# - Managed workspace configuration
# - Provider pacing and rate limiting
# - Runner-specific settings
# - Git commit/push behavior
# - Visual snapshots
# - Custom binary paths
# - And more...

# ============================================================================
# QUICK START
# ============================================================================
# 1. Set IMEMORY_API_KEY (get from https://projectm.dev)
# 2. Set IMEMORY_WORKSPACE_ALLOWLIST to your project directories
# 3. Set CURSOR_API_KEY or install a CLI tool
# 4. Run: projectmind-agent
#
# For help: projectmind-agent doctor
