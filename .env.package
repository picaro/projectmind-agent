# ProjectMind desktop agent — sample .env (edit before running)
# Included in download zips so you can start without copying .env.example.

# Project API key from ProjectMind → Project → Settings → API keys
IMEMORY_API_KEY=imk_your_project_api_key

# Production MCP endpoint (real app URL). For local ProjectMind, use http://localhost:8080/api/mcp
IMEMORY_MCP_URL=https://projectm.dev/api/mcp

# Required to execute jobs — comma-separated absolute roots the agent may use as cwd.
# macOS/Linux example: /Users/you/CursorIDE,/Users/you/work
# Windows example: C:\Users\you\CursorIDE,C:\Users\you\work
IMEMORY_WORKSPACE_ALLOWLIST=/Users/you/work

# Optional — required for global keys (imgk_) or multi-project OAuth users
# IMEMORY_PROJECT_SLUG=your-project-slug

# Optional opaque agent identity (recommended on shared machines)
# IMEMORY_AGENT_KEY=agt_use_a_long_random_string

# --- Runners (set at least one) ---
# Cursor SDK local runner (used first by auto when key is set)
CURSOR_API_KEY=

# OpenAI / Codex / LLM API
OPENAI_API_KEY=
# CODEX_API_KEY=

# OpenRouter agent runner (select `openrouter`; not included in auto)
# OPENROUTER_API_KEY=
# IMEMORY_OPENROUTER_MODEL=openai/gpt-4.1-mini

# TokenRouter agent runner (select `tokenrouter`; not included in auto)
# TOKENROUTER_API_KEY=
# IMEMORY_TOKENROUTER_MODEL=openai/gpt-4.1-mini

# Default runner: auto | cursor_sdk | cursor_cli | codex_cli | antigravity_cli | claude_cli | copilot_cli | openrouter | tokenrouter | llm_api
# IMEMORY_DEFAULT_RUNNER=auto
