{
  "name": "projectmind-agent",
  "version": "0.5.0",
  "type": "module",
  "description": "Desktop agent (macOS/Windows/Ubuntu) that heartbeats to ProjectMind and runs claimed task jobs via Cursor SDK, Cursor CLI, Codex CLI, Antigravity CLI, or LLM API",
  "main": "./dist/cli.cjs",
  "bin": {
    "projectmind-agent": "dist/cli.cjs",
    "imemory-agent": "dist/cli.cjs"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "start": "tsx src/index.ts",
    "build": "node scripts/build-npm.mjs",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "prepublishOnly": "pnpm run build && pnpm test",
    "build:release": "node scripts/build-release.mjs"
  },
  "dependencies": {
    "@cursor/sdk": "^1.0.24",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "dotenv": "^16.6.1",
    "fflate": "^0.8.3",
    "zod": "^4.6.7"
  },
  "engines": {
    "node": ">=22.13"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "@vitest/coverage-v8": "^3.2.7",
    "@yao-pkg/pkg": "^6.14.1",
    "esbuild": "^0.25.5",
    "tsx": "^4.20.5",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "pkg": {
    "assets": [],
    "outputPath": "dist-release/bin"
  },
  "packageManager": "pnpm@10.17.1",
  "pnpm": {
    "overrides": {
      "vite": "7.3.8",
      "undici@^5.0.0": "6.29.1",
      "undici@^6.0.0": "6.29.1",
      "undici@^7.0.0": "7.30.2",
      "proxy-addr": "2.0.8",
      "body-parser@^2": "2.4.0",
      "@modelcontextprotocol/sdk": "1.32.2",
      "zod@^4": "4.6.7"
    },
    "onlyBuiltDependencies": [
      "esbuild",
      "workerd",
      "better-sqlite3",
      "ffmpeg-static",
      "unrs-resolver",
      "sharp",
      "@parcel/watcher",
      "msgpackr-extract",
      "protobufjs",
      "core-js",
      "supabase"
    ]
  }
}
